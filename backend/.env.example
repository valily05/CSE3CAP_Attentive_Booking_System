# Copy to your shell or a process manager. Never commit real values (Scope §13).
DATABASE_URL=postgres://careconnect:careconnect@localhost:5433/careconnect?sslmode=disable
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:3000
RUN_JOBS=true
# Select brevo for real transactional email, smtp for local Mailpit.
MAIL_PROVIDER=smtp
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Attentive
# Mailpit in development. For Brevo: smtp-relay.brevo.com:587 plus your SMTP login.
SMTP_ADDR=localhost:1025
SMTP_FROM=Attentive <no-reply@attentive.test>
SMTP_USER=
SMTP_PASSWORD=
